{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PhotoHarbor",
  "mainBinaryName": "PhotoHarbor",
  "version": "1.0.0",
  "identifier": "com.imageorganizer.app",
  "build": {
    "frontendDist": "../web",
    "beforeDevCommand": "npm run desktop:prepare",
    "beforeBuildCommand": "npm run desktop:prepare"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PhotoHarbor",
        "width": 1280,
        "height": 880,
        "minWidth": 800,
        "minHeight": 640,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/image-worker"
    ],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "languages": [
          "English"
        ],
        "installMode": "currentUser"
      }
    }
  }
}
