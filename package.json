{
  "name": "photoharbor",
  "version": "1.0.0",
  "description": "PhotoHarbor - Organize photos by category and date with MySQL indexing",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "organize": "ts-node src/index.ts organize",
    "organize:move": "ts-node src/index.ts organize --move",
    "organize:dry": "ts-node src/index.ts organize --dry-run",
    "stats": "ts-node src/index.ts stats",
    "watch": "tsc --watch",
    "clean": "rimraf dist",
    "tauri": "tauri",
    "desktop:prepare": "node scripts/build-sidecar.cjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "pack": "tauri build --no-bundle",
    "dist": "tauri build"
  },
  "keywords": [
    "image",
    "organizer",
    "exif",
    "mysql"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "exif-parser": "^0.1.12",
    "mysql2": "^3.6.5",
    "ora": "^5.4.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "@tauri-apps/cli": "^2.0.0",
    "@yao-pkg/pkg": "^6.0.0",
    "esbuild": "^0.25.0"
  },
  "engines": {
    "node": ">=22"
  }
}
